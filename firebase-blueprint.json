{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A productivity task in the system",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the owner" },
        "title": { "type": "string" },
        "project": { "type": "string" },
        "category": { "type": "string", "enum": ["Urgent", "Focus", "Archive"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "isDone": { "type": "boolean" },
        "notes": { "type": "string" },
        "urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "isStarred": { "type": "boolean" },
        "section": { "type": "string" },
        "deadline": { "type": "number", "description": "Deadline timestamp (optional)" }
      },
      "required": ["userId", "title", "project", "category", "createdAt", "updatedAt", "isDone"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User specific app configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "urgentLimit": { "type": "number" },
        "deadlineThreshold": { "type": "number" },
        "archiveThresholdDays": { "type": "number" },
        "warningThreshold": { "type": "number" },
        "criticalThreshold": { "type": "number" },
        "isLocalBackupEnabled": { "type": "boolean" },
        "localBackupPath": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "ja"] },
        "archiveDoneToTrashDays": { "type": "number" },
        "archiveInactiveToTrashDays": { "type": "number" },
        "phaseConfigs": { "type": "object", "description": "Section-mapped phase patterns and active pattern" }
      },
      "required": ["userId", "urgentLimit", "archiveThresholdDays", "warningThreshold", "criticalThreshold", "isLocalBackupEnabled", "localBackupPath", "language"]
    },
    "Folder": {
      "title": "Folder",
      "description": "Folder metadata including deadlines, stars, and pins",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "path": { "type": "string" },
        "name": { "type": "string" },
        "section": { "type": "string" },
        "category": { "type": "string", "enum": ["Focus", "Archive", "Trash"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "isDone": { "type": "boolean" },
        "notes": { "type": "string" },
        "urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "isStarred": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "isAllDay": { "type": "boolean" },
        "deadline": { "type": "number" },
        "startDate": { "type": "number" }
      },
      "required": ["userId", "path", "category"]
    },
    "PhaseConfig": {
      "title": "PhaseConfig",
      "description": "User timeline phase patterns and custom columns configuration synchronized per workspace section",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the owner" },
        "section": { "type": "string", "description": "Workspace section name" },
        "activePatternId": { "type": "string", "description": "ID of active phase pattern" },
        "patterns": {
          "type": "array",
          "description": "Array of phase patterns"
        },
        "updatedAt": { "type": "number", "description": "Timestamp of last modification" }
      },
      "required": ["userId", "section", "patterns"]
    },
    "PhasePattern": {
      "title": "PhasePattern",
      "description": "Individual timeline phase pattern variation with columns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "section": { "type": "string" },
        "name": { "type": "string" },
        "columns": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "name", "columns"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of tasks"
    },
    "/folders/{folderId}": {
      "schema": "Folder",
      "description": "Collection of folders"
    },
    "/settings/{userId}": {
      "schema": "UserSettings",
      "description": "User specific settings"
    },
    "/phase_configs/{configId}": {
      "schema": "PhaseConfig",
      "description": "Synchronized phase patterns configuration per user and section"
    },
    "/phase_patterns/{patternDocId}": {
      "schema": "PhasePattern",
      "description": "Collection of timeline phase pattern configurations"
    }
  }
}
